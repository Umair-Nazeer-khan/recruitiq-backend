# ═══════════════════════════════════════════════
#  Fair Hire AI — Environment Variables
#  Copy this file to .env and fill in your values
#  NEVER commit .env to GitHub
# ═══════════════════════════════════════════════

# Django
SECRET_KEY=replace-with-a-random-secret-at-least-50-characters-long
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,10.0.2.2

# MySQL Database
DB_NAME=fairhire_db
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_HOST=localhost
DB_PORT=3306

# JWT Token settings (in minutes/days)
ACCESS_TOKEN_LIFETIME=60
REFRESH_TOKEN_LIFETIME=7

# Firebase Admin SDK (for push notifications)
# Download from Firebase Console → Project Settings → Service Accounts
FIREBASE_CREDENTIALS_PATH=firebase-credentials.json

# Railway deployment: set these in the Railway service Variables UI.
# Do not commit real values. Generate SECRET_KEY with:
# python -c "import secrets; print(secrets.token_urlsafe(50))"
# SECRET_KEY=<generated value, at least 50 characters>
# DEBUG=False
# ALLOWED_HOSTS=<your-new-service>.up.railway.app
# DATABASE_URL=<reference the Railway MySQL service URL variable>
# CORS_ALLOWED_ORIGINS=<your frontend origin, only needed for browser clients>
# GEMINI_API_KEY=<optional; enables Gemini-assisted resume parsing>
# GROQ_API_KEY=<optional; used if Gemini parsing fails>
# GROQ_MODEL=openai/gpt-oss-120b
